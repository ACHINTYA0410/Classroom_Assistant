SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key
# Optional for legacy HS256 tokens; otherwise Auth verifies them remotely.
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
GEMINI_API_KEY=your-backend-only-gemini-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Same-provider failover for transient generation outages; empty disables it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=45
LLM_TIMEOUT_SECONDS=12
LLM_REQUESTS_PER_MINUTE=20
# Server-side test-only calendar shortcut; keep false in production.
ENABLE_TEST_TOOLS=false
